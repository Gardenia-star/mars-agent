# ============================================================
#  MARS-Agent 大模型配置模板（通义千问 / 阿里云百炼）
# ------------------------------------------------------------
#  用法：复制成 .env 再填上自己的 Key
#      cp .env.example .env
#  .env 会被程序自动读取，且已被 .gitignore 忽略（不会误提交密钥）。
# ============================================================

# 【必填】百炼 API Key，形如 sk-xxxxxxxxxxxxxxxx
#  获取地址：https://bailian.console.aliyun.com/  →  右上角「API-KEY」
DASHSCOPE_API_KEY= API_KEY

# 服务地址（默认中国北京；国际站用 dashscope-intl.aliyuncs.com）
#MARS_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 视觉模型：qwen-vl-max / qwen-vl-plus / qwen3-vl-plus / qwen3-vl-235b-a22b-instruct
#MARS_LLM_MODEL=qwen-vl-max

#MARS_LLM_TIMEOUT=180
#MARS_LLM_MAX_TOKENS=2048
#MARS_LLM_DETAIL=
#MARS_LLM_ENABLED=true
